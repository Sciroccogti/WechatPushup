<view class="page">
  <view class="home-hero">
    <view class="hero-top"><view class="brand">{{appName}}</view><text class="hero-badge">离线可用</text></view>
    <view class="hero">今天，<text class="hero-line">练好一点。</text></view>
    <view class="intro">按自己的节奏开始，记录每一次进步。</view>
  </view>
  <view class="section-heading"><view><view class="section-title">选择运动</view><view class="section-caption">你的下一组，从这里开始</view></view><picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange"><view class="sort-picker">{{sortOptions[sortIndex]}} ▾</view></picker></view>
  <view class="exercise-grid">
    <navigator wx:for="{{exercises}}" wx:key="id" class="exercise-tile" url="{{item.trainingUrl}}" hover-class="button-hover">
      <view class="tile-top"><text class="type-tag {{item.isTimed ? 'type-timed' : ''}}">{{item.typeLabel}}</text><text class="tile-arrow" aria-hidden="true">↗</text></view>
      <view class="exercise-name">{{item.name}}</view>
      <view class="tile-unit">{{item.usageLabel}}</view>
    </navigator>
  </view>
  <view wx:if="{{storageWarning}}" class="opt-warning">{{storageWarning}}</view>
  <navigator class="record-link" url="/pages/history/index" open-type="switchTab" hover-class="button-hover"><view><view class="section-title">训练足迹</view><view class="section-caption">查看记录与近期变化</view></view><text class="tile-arrow" aria-hidden="true">›</text></navigator>
  <view class="muted availability">三个计次项目支持触屏与传感器，平板支撑使用计时器。自动检测为实验功能，效果待真机验证。</view>
</view>
