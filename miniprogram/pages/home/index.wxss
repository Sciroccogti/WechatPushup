.brand { font-size: 26rpx; font-weight: 600; letter-spacing: 2rpx; color: #456a50; }
.hero { margin-top: 36rpx; font-size: 58rpx; line-height: 1.35; font-weight: 700; letter-spacing: -1rpx; }
.hero-line { display: block; }
.intro { margin-top: 24rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 40rpx 0 20rpx; font-size: 32rpx; font-weight: 600; }
.exercise-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.exercise-tile { width: 48%; padding: 26rpx; margin-bottom: 20rpx; background: #fff; border: 1rpx solid #e3e9e1; border-radius: 24rpx; }
.tile-top { display: flex; align-items: center; justify-content: space-between; }
.sort-picker { font-size: 24rpx; color: #285d3e; padding: 20rpx 14rpx; background: #eaf0e6; border-radius: 16rpx; font-weight: 400; }
.exercise-name { margin-top: 26rpx; font-size: 32rpx; font-weight: 600; }
.tile-unit { margin-top: 8rpx; color: #66776c; font-size: 24rpx; }
.availability { margin-top: 4rpx; font-size: 24rpx; }
.record-link { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; padding: 24rpx 8rpx; margin-top: 20rpx; font-size: 28rpx; color: #456a50; }
