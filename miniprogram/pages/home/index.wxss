.home-hero { padding: 32rpx; border-radius: 32rpx; background: linear-gradient(130deg, #142b49, #244b7d); color: #fff; }
.hero-top, .tile-top { display: flex; align-items: center; justify-content: space-between; }
.brand { font-size: 24rpx; font-weight: 600; color: #d1e0f5; }
.hero-badge { font-size: 21rpx; padding: 6rpx 14rpx; border: 1rpx solid rgba(255,255,255,.22); border-radius: 30rpx; color: #d1e0f5; }
.hero { margin-top: 24rpx; font-size: 62rpx; line-height: 1.15; font-weight: 700; letter-spacing: -2rpx; }
.hero-line { display: block; color: #ffb36b; }
.intro { margin-top: 24rpx; font-size: 24rpx; color: #d1e0f5; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 32rpx 0 20rpx; }
.section-caption { font-size: 23rpx; color: #5d6f87; margin-top: 6rpx; }
.exercise-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.exercise-tile { width: 48%; padding: 26rpx; margin-bottom: 20rpx; background: #fff; border: 1rpx solid #e3eaf4; border-radius: 28rpx; box-shadow: 0 6rpx 24rpx rgba(20,43,73,.035); }
.tile-arrow { font-size: 32rpx; color: #bd4618; line-height: 1; }
.sort-picker { font-size: 22rpx; color: #3e5a7c; padding: 16rpx; background: #e8eef7; border-radius: 20rpx; white-space: nowrap; }
.exercise-name { margin-top: 28rpx; font-size: 34rpx; line-height: 1.3; font-weight: 700; }
.tile-unit { margin-top: 12rpx; color: #5d6f87; font-size: 22rpx; }
.availability { margin-top: 24rpx; font-size: 23rpx; line-height: 1.7; }
.record-link { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; margin-top: 4rpx; background: #fff; border: 1rpx solid #e3eaf4; border-radius: 28rpx; }
