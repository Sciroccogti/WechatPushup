<import src="../../templates/optical.wxml" />
<view class="training-scene {{phase === 'running' ? 'training-active' : ''}}" style="background-color: {{feedbackColor}};" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel">
  <view class="training-backdrop" style="background-color: {{feedbackColor}};" aria-hidden="true"></view>
  <view class="training-effects" aria-hidden="true"><view wx:for="{{touchRipples}}" wx:key="id" class="touch-ripple" style="left: {{item.x}}; top: {{item.y}}; background-color: {{item.color}};"></view></view>
  <view wx:for="{{touchRipples}}" wx:key="id" class="touch-confirmation" style="left: {{item.x}}; top: {{item.y}};" aria-hidden="true">{{exercise.isTimed ? '计时中' : '+1'}}</view>
  <view class="page training-page">
    <view class="training-toolbar" mark:control="{{true}}" bindtouchstart="onControlTouchStart">
      <picker class="exercise-picker" mode="selector" range="{{exerciseNames}}" value="{{exerciseIndex}}" bindchange="onExerciseChange" disabled="{{phase === 'running' || phase === 'calibrating'}}"><view>{{exercise ? exercise.name : '选择运动项目'}} ▾</view></picker>
      <picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange"><view class="training-sort">{{sortOptions[sortIndex]}} ▾</view></picker>
    </view>
    <block wx:if="{{exercise && !blockedMessage}}">
      <view class="training-touch-surface" catchtouchmove="preventTouchMove">
        <view class="training-purpose">{{purpose === 'plan' ? '五组计划' : purpose === 'assessment' ? '能力测试' : '自由训练'}} · 第 {{groupNumber}} / {{groupCount}} 组</view>
        <view class="training-phase">{{phase === 'running' ? '训练中' : phase === 'calibrating' ? '设备校准中' : phase === 'paused' ? '已暂停' : phase === 'rest' ? '休息中' : phase === 'ready' ? '准备下一组' : phase === 'finished' ? '已结束' : '准备开始'}}</view>
        <view class="training-count">{{count}}<text class="training-unit">{{exercise.unit}}</text></view>
        <view class="training-target">本组目标 {{target}} {{exercise.unit}}</view>
        <view class="training-touch-hint">{{exercise.isTimed ? (phase === 'running' ? '轻触任意空白处，查看涟漪反馈' : '轻触大区域开始 / 继续计时') : (phase === 'running' ? '轻触屏幕大区域 +1' : '开始训练后，轻触大区域计数')}}</view>
        <view class="training-touch-detail">{{exercise.isTimed ? '触屏不会暂停或重置已用时间' : selectedMode === 'optical' ? '光学 + 触屏同时可用 · 相邻信号合并去重' : selectedMode === 'gyro' ? '陀螺仪 + 触屏同时可用 · 相邻信号合并去重' : '长按不连加 · 触屏最小间隔 600 ms'}}</view>
        <view class="training-metrics"><text>累计 {{total}} {{exercise.unit}}</text><text>训练 {{elapsed}}</text></view>
      </view>
      <view class="training-controls" mark:control="{{true}}" bindtouchstart="onControlTouchStart">
        <view wx:if="{{phase !== 'running'}}" class="training-setup">
          <view class="muted">暂停后可在上方更换项目；更换会结束当前训练并进入新项目的自由训练。</view>
          <view wx:if="{{exercise.isTimed}}" class="section-title spaced">计时器 · 无需传感器</view>
          <block wx:else>
            <view class="opt-row"><button class="opt-button {{selectedMode === 'touch' ? 'opt-primary' : ''}}" bindtap="selectTouch">仅触屏</button><button wx:if="{{exercise.sensor === 'optical'}}" class="opt-button" bindtap="startOptical" disabled="{{phase === 'rest' || phase === 'ready' || phase === 'finished'}}">光学 + 触屏</button><button wx:if="{{exercise.sensor === 'gyro'}}" class="opt-button" bindtap="startGyro" disabled="{{phase === 'rest' || phase === 'ready' || phase === 'finished'}}">陀螺仪 + 触屏</button></view>
            <navigator wx:if="{{exercise.sensor === 'optical'}}" class="opt-button tuning-link" url="/pages/calibration/index">俯卧撑光学阈值与实时测试 ›</navigator>
            <view wx:if="{{exercise.sensor === 'gyro'}}"><view class="muted spaced">手机竖向固定胸前 / 上身，先静止校准；检测效果待真机验证。</view><picker mode="selector" range="{{gyroAxes}}" value="{{gyroAxisIndex}}" bindchange="onGyroAxisChange"><view class="field-input">{{gyroAxes[gyroAxisIndex]}} ▾</view></picker></view>
          </block>
        </view>
        <view wx:if="{{exercise.sensor === 'optical' && selectedMode === 'optical'}}" class="training-sensor-dock"><template is="optical-panel" data="{{...optical, compact: phase === 'running'}}" /></view>
        <view wx:if="{{selectedMode === 'gyro'}}" class="training-sensor-readout">陀螺仪 {{gyro.state}} · X {{gyro.x}} / Y {{gyro.y}} / Z {{gyro.z}}</view>
        <view wx:if="{{!exercise.isTimed}}" class="opt-row"><button class="opt-button" bindtap="manualAdd" disabled="{{phase !== 'running'}}">手动 +1</button><button class="opt-button" bindtap="undoCount" disabled="{{phase !== 'running'}}">撤销 −1</button><button class="opt-button" bindtap="resetCount" disabled="{{phase !== 'running'}}">本组清零</button></view>
        <view class="training-action-status" aria-live="polite">{{phase === 'running' ? (exercise.isTimed ? '计时已开始，无需再次点击屏幕' : '计数已开始，轻触上方大区域 +1') : phase === 'calibrating' ? '正在等待设备就绪 / 校准' : phase === 'paused' ? '已暂停，点击继续训练' : phase === 'idle' ? '准备就绪，点击开始训练' : ''}}</view>
        <view class="opt-row training-main-actions"><button wx:if="{{phase !== 'running'}}" class="opt-button opt-primary training-start-button" bindtap="startCounting" disabled="{{phase === 'running' || phase === 'calibrating' || phase === 'rest' || phase === 'ready' || phase === 'finished'}}">{{phase === 'calibrating' ? '设备准备中' : phase === 'paused' ? '继续训练' : '开始训练'}}</button><button class="opt-button training-pause-button" bindtap="pauseCounting" disabled="{{phase !== 'running' && phase !== 'calibrating'}}">暂停</button><button class="opt-button training-end-button" bindtap="endCounting">结束</button></view>
        <view wx:if="{{purpose === 'plan' && phase !== 'running'}}" class="card detail-card"><view class="section-title">本组操作</view><view class="opt-row"><button class="opt-button" bindtap="finishGroup" disabled="{{phase !== 'paused' && phase !== 'idle'}}">提前完成本组</button><button class="opt-button" bindtap="skipGroup" disabled="{{phase !== 'paused' && phase !== 'idle'}}">跳过本组</button></view><input class="field-input" type="number" value="{{targetDraft}}" bindinput="onTargetInput" placeholder="调整当前组目标" /><button class="opt-button" bindtap="applyTarget">应用目标</button></view>
        <view wx:if="{{phase === 'rest' || phase === 'ready'}}" class="card detail-card"><view>休息 {{restSeconds}} 秒</view><button class="opt-button" bindtap="nextGroup">开始下一组</button></view>
        <view wx:if="{{purpose === 'assessment' && phase !== 'running'}}" class="muted spaced">完成有效能力测试后结束并确认结果；不适时停止。</view>
        <view wx:if="{{notice || storageMessage}}" class="opt-warning">{{notice}} {{storageMessage}}</view>
      </view>
      <view mark:control="{{true}}" bindtouchstart="onControlTouchStart"><template is="optical-privacy" data="{{privacyVisible: optical.privacyVisible}}" /></view>
    </block>
    <block wx:else><view class="training-empty" mark:control="{{true}}" bindtouchstart="onControlTouchStart"><empty-state heading="{{blockedMessage || '在上方选择运动，开始训练'}}" /><navigator class="button button-primary spaced" url="/pages/home/index" open-type="switchTab">回到训练首页</navigator></view></block>
  </view>
</view>
