<import src="../../templates/optical.wxml" />
<view class="page">
  <block wx:if="{{exercise}}">
    <view class="training-heading">
      <view><view class="eyebrow">自由训练</view><view class="exercise-title">{{exercise.name}}</view></view>
      <navigator class="change-link" url="/pages/exercises/index" open-type="redirect" hover-class="button-hover">更换项目</navigator>
    </view>
    <view class="muted exercise-description">{{exercise.description}}</view>
    <view class="counter-preview">
      <view class="preview-heading"><text>{{exercise.isTimed ? exercise.currentLabel : '本次次数'}}</text><text class="status-pill">{{phase === 'running' ? '计数中' : phase === 'calibrating' ? '授权 / 校准中' : phase === 'paused' ? '已暂停' : phase === 'ended' ? '已结束' : '尚未开始'}}</text></view>
      <view class="counter-value">{{exercise.isTimed ? '—' : count}}<text class="counter-unit">{{exercise.unit}}</text></view>
      <view class="counter-caption">{{exercise.isTimed ? '计时功能准备中' : selectedMode === 'optical' ? '光学明暗周期计数 · 实验功能' : '触屏计数'}}</view>
      <view class="preview-divider"></view>
      <view class="preview-summary"><text>个人计划</text><text>尚未设置</text></view>
    </view>

    <view wx:if="{{!exercise.isTimed}}">
      <view class="card detail-card">
        <view class="section-title">计数方式</view>
        <view class="opt-row"><button class="opt-button {{selectedMode === 'touch' ? 'opt-primary' : ''}}" bindtap="selectTouch">触屏</button><button class="opt-button {{selectedMode === 'optical' ? 'opt-primary' : ''}}" bindtap="startOptical">开启光学</button></view>
        <navigator class="opt-button tuning-link" url="/pages/calibration/index">光学阈值与实时测试 ›</navigator>
      </view>
      <template wx:if="{{selectedMode === 'optical'}}" is="optical-panel" data="{{...optical}}" />
      <view wx:if="{{selectedMode === 'touch'}}" class="touch-counter" catchtouchstart="onTouchStart" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd" catchtouchmove="preventTouchMove">{{phase === 'running' ? '轻触这里 +1' : '开始或继续后轻触计数'}}<view class="touch-note">每次触碰只计一次 · 最小间隔 600 ms</view></view>
      <view class="opt-row"><button class="opt-button" bindtap="manualAdd" disabled="{{phase !== 'running'}}">手动 +1</button><button class="opt-button" bindtap="undoCount">撤销 −1</button><button class="opt-button" bindtap="resetCount">清零</button></view>
      <view class="opt-row"><button class="opt-button opt-primary" bindtap="startCounting" disabled="{{phase === 'running' || phase === 'calibrating'}}">{{phase === 'paused' ? '继续计数' : '开始计数'}}</button><button class="opt-button" bindtap="pauseCounting" disabled="{{phase !== 'running' && phase !== 'calibrating'}}">暂停</button><button class="opt-button" bindtap="endCounting">结束</button></view>
      <view class="muted footer-description">当前为自由计数，不生成五组计划、不保存训练记录。光学仅检测亮度周期，不判断动作是否标准。</view>
    </view>
    <view wx:else class="muted footer-description">平板支撑计时功能准备中，无需摄像头。</view>
    <view wx:if="{{notice}}" class="opt-warning">{{notice}}</view>
    <view wx:if="{{storageMessage}}" class="opt-warning">{{storageMessage}}</view>
    <template is="optical-privacy" data="{{privacyVisible: optical.privacyVisible}}" />
  </block>
  <block wx:else>
    <empty-state heading="请先选择运动项目" description="此入口没有有效的运动项目，请重新选择。" show-home="{{false}}" />
    <navigator class="button button-primary select-link" url="/pages/exercises/index" open-type="redirect" hover-class="button-hover">选择运动项目</navigator>
    <navigator class="button home-link" url="/pages/home/index" open-type="switchTab" hover-class="button-hover">回到首页</navigator>
  </block>
</view>
