.training-heading { display: flex; align-items: center; justify-content: space-between; }
.eyebrow { font-size: 24rpx; color: #5d6f87; }
.exercise-title { font-size: 46rpx; font-weight: 700; line-height: 1.4; margin-top: 10rpx; }
.change-link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 18rpx; font-size: 26rpx; color: #245dbe; background: #e8f0fc; border-radius: 18rpx; }
.exercise-description { margin-top: 18rpx; }
.counter-preview { margin-top: 32rpx; padding: 32rpx; background: #142b49; color: #f2f6ff; border-radius: 30rpx; }
.preview-heading { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; color: #bccde3; }
.status-pill { color: #c5dfff; background: #283d57; font-size: 22rpx; border-radius: 12rpx; padding: 6rpx 14rpx; }
.counter-value { text-align: center; font-size: 132rpx; font-weight: 700; line-height: 1.3; padding-top: 28rpx; }
.counter-unit { font-size: 28rpx; font-weight: 400; color: #bccde3; margin-left: 16rpx; }
.counter-caption { font-size: 26rpx; text-align: center; color: #bccde3; margin-top: 8rpx; }
.preview-divider { height: 1rpx; background: #405570; margin: 32rpx 0 20rpx; }
.preview-summary { display: flex; justify-content: space-between; font-size: 25rpx; color: #bccde3; }
.session-metrics { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 4rpx; }
.metric { width: 48%; margin-top: 20rpx; padding: 24rpx; background: #fff; border: 1rpx solid #d5dfed; border-radius: 22rpx; }
.metric-label { font-size: 24rpx; color: #5d6f87; }
.metric-value { margin-top: 10rpx; font-size: 38rpx; font-weight: 600; }
.detail-card { margin-top: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.target-status { margin-top: 20rpx; font-size: 28rpx; }
.detail-description { margin-top: 14rpx; font-size: 24rpx; }
.mode-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-top: 12rpx; font-size: 27rpx; }
.mode-status { color: #5d6f87; font-size: 23rpx; margin-left: 20rpx; }
.training-footer { margin-top: 32rpx; }
.button-unavailable[disabled] { color: #5d6f87; background: #d5dfed; border: 0; }
.button-unavailable::after { border: 0; }
.footer-description { margin-top: 16rpx; font-size: 24rpx; text-align: center; }
.select-link { margin-top: 28rpx; }
.home-link { margin-top: 16rpx; color: #3e5a7c; }
.tuning-link { display: block; text-align: center; padding: 24rpx; }
.training-scene { position: relative; min-height: 100vh; color: #182e49; }
.training-backdrop { position: fixed; top: 0; right: 0; bottom: 0; left: 0; pointer-events: none; z-index: 0; }
.training-effects { position: fixed; top: 0; right: 0; bottom: 0; left: 0; overflow: hidden; pointer-events: none; z-index: 1; }
.touch-ripple { position: absolute; width: 12vmax; height: 12vmax; margin-left: -6vmax; margin-top: -6vmax; border-radius: 50%; pointer-events: none; animation: training-ripple 560ms cubic-bezier(.16,.6,.3,1) both; }
.touch-ripple::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; right: 0; border: .5rpx solid rgba(255,255,255,.65); border-radius: 50%; }
@keyframes training-ripple { from { transform: scale(0); } to { transform: scale(26); } }
.touch-confirmation { position: fixed; z-index: 4; pointer-events: none; color: #fff; background: #245dbe; padding: 10rpx 24rpx; border-radius: 40rpx; font-size: 32rpx; font-weight: 700; animation: touch-confirmation 720ms ease-out both; }
@keyframes touch-confirmation { 0% { opacity: 1; transform: translate(-50%, -50%) scale(.8); } 35% { opacity: 1; transform: translate(-50%, -70%) scale(1.1); } 100% { opacity: 0; transform: translate(-50%, -140%) scale(1); } }
.training-page { position: relative; z-index: 2; padding-top: 22rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.training-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.exercise-picker { max-width: 55%; font-size: 34rpx; font-weight: 700; padding: 14rpx 10rpx; }
.training-sort { font-size: 23rpx; padding: 18rpx; background: #e8eef7; border-radius: 20rpx; color: #3e5a7c; }
.training-touch-surface { min-height: 57vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 10rpx; text-align: center; }
.training-active .training-touch-surface { min-height: 60vh; }
.training-purpose { font-size: 25rpx; color: #526985; }
.training-phase { margin-top: 16rpx; padding: 6rpx 22rpx; border: 1rpx solid #d8e5f8; border-radius: 28rpx; background: #edf4ff; color: #245dbe; font-size: 24rpx; }
.training-count { font-size: 180rpx; font-weight: 700; line-height: 1.3; margin-top: 24rpx; font-variant-numeric: tabular-nums; }
.training-unit { margin-left: 14rpx; font-size: 30rpx; font-weight: 400; }
.training-target { color: #526985; font-size: 27rpx; }
.training-touch-hint { margin-top: 38rpx; font-size: 31rpx; font-weight: 600; }
.training-touch-detail { margin-top: 12rpx; font-size: 23rpx; color: #526985; }
.training-metrics { display: flex; width: 100%; justify-content: space-around; margin-top: 40rpx; font-size: 26rpx; color: #3e5a7c; }
.training-controls { padding-bottom: 10rpx; }
.training-action-status { margin-top: 18rpx; font-size: 25rpx; color: #245dbe; text-align: center; min-height: 40rpx; }
.training-setup { padding: 22rpx; background: #fff; border: 1rpx solid #e3eaf4; border-radius: 28rpx; }
.training-controls .opt-button { background: #e8eef7; color: #3e5a7c; }
.training-controls .opt-primary { background: #bd4618; color: #fff; }
.training-sensor-readout { font-size: 22rpx; color: #526985; text-align: center; padding: 10rpx; }
.training-empty { margin-top: 38rpx; }
/* 训练/休息页使用大触区，覆盖全局小号光学工具按钮的尺寸。 */
.training-controls .opt-row { margin-top: 24rpx; align-items: stretch; }
.training-controls .opt-button, .rest-page .opt-button, .rest-page .button { display: flex; align-items: center; justify-content: center; min-height: 136rpx; padding: 24rpx 18rpx; border-radius: 24rpx; font-size: 32rpx; font-weight: 600; line-height: 1.4; white-space: normal; }
.training-controls .opt-row .opt-button, .rest-page .opt-row .opt-button { margin-left: 8rpx; margin-right: 8rpx; }
.training-controls .training-main-actions { flex-wrap: wrap; margin-top: 24rpx; }
.training-controls .training-main-actions .training-start-button { flex: 0 0 100%; width: 100%; min-height: 176rpx; margin: 0 0 24rpx; font-size: 40rpx; }
.training-controls .training-main-actions .training-pause-button, .training-controls .training-main-actions .training-end-button { min-height: 160rpx; font-size: 36rpx; }
.training-controls .training-main-actions .training-pause-button { margin-left: 0; }
.training-controls .training-main-actions .training-end-button { margin-right: 0; }
.training-controls .tuning-link { min-height: 128rpx; font-size: 30rpx; }
.rest-page .opt-row { margin-top: 24rpx; align-items: stretch; }
.rest-page .button-primary { width: 100%; min-height: 176rpx; font-size: 40rpx; }
.rest-page .opt-row .opt-button { min-height: 144rpx; }
/* 准备界面使用视口内的纵向布局；大触区和训练中的按钮尺寸保持。 */
.training-prestart .training-page { height: 100vh; display: flex; flex-direction: column; padding: 12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); }
.training-prestart .training-toolbar { min-height: 72rpx; flex-shrink: 0; }
.training-prestart .exercise-picker { padding: 8rpx; font-size: 32rpx; }
.training-prestart .training-sort { padding: 12rpx; }
.training-prestart .training-touch-surface { flex: 1; min-height: 0; padding: 12rpx 0; }
.training-prestart .training-purpose { font-size: 23rpx; line-height: 1.3; }
.training-prestart .training-phase { margin-top: 8rpx; padding: 4rpx 16rpx; line-height: 1.3; font-size: 22rpx; }
.training-prestart .training-count { margin-top: 8rpx; font-size: 76rpx; line-height: 1.15; }
.training-prestart .training-target { font-size: 24rpx; line-height: 1.4; }
.training-prestart .training-touch-hint, .training-prestart .training-touch-detail { display: none; }
.training-prestart .training-metrics { margin-top: 12rpx; font-size: 22rpx; }
.training-prestart .training-controls { flex-shrink: 0; padding: 0; }
.training-prestart .training-setup { padding: 12rpx; border-radius: 28rpx; }
.training-prestart .training-setup .opt-row { margin-top: 0; }
.training-prestart .training-setup .opt-button { min-height: 88rpx; padding: 12rpx 8rpx; font-size: 26rpx; border-radius: 20rpx; }
.setup-hint { font-size: 22rpx; color: #526985; line-height: 1.5; margin-top: 8rpx; text-align: center; }
.training-utilities { display: flex; justify-content: space-between; align-items: center; }
.training-utility { min-height: 72rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 12rpx; background: transparent; color: #245dbe; font-size: 24rpx; line-height: 1.4; }
.training-prestart .training-action-status { margin-top: 8rpx; font-size: 23rpx; line-height: 1.4; min-height: 32rpx; }
.training-prestart .training-main-actions { margin-top: 12rpx; }
.training-prestart .training-main-actions .training-start-button { margin-bottom: 0; }
.training-prestart .training-main-actions .training-pause-button, .training-prestart .training-main-actions .training-end-button { min-height: 96rpx; padding: 12rpx; font-size: 30rpx; }
.training-prestart .training-main-actions .training-end-button { margin-top: 12rpx; }
.training-prestart .training-sensor-readout { padding: 6rpx; font-size: 21rpx; }
.training-prestart .opt-warning { margin-top: 8rpx; padding: 10rpx; font-size: 22rpx; }
.training-sheet-mask { position: fixed; z-index: 50; inset: 0; display: flex; align-items: flex-end; padding: 24rpx; background: rgba(20,43,73,.65); }
.training-sheet { width: 100%; max-height: 80vh; overflow-y: auto; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx; background: #f2f5fa; }
@media (max-height: 560px) {
  .training-prestart .training-page { padding-top: 4rpx; padding-bottom: calc(8rpx + env(safe-area-inset-bottom)); }
  .training-prestart .training-count { font-size: 64rpx; margin-top: 4rpx; }
  .training-prestart .training-touch-surface { padding: 4rpx 0; }
  .training-prestart .training-main-actions .training-start-button { min-height: 160rpx; }
  .training-utility { min-height: 64rpx; padding: 8rpx; }
}
