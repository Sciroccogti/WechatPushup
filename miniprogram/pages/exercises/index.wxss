.page-heading { font-size: 46rpx; line-height: 1.4; font-weight: 700; }
.page-description { margin-top: 18rpx; }
.sort-picker { margin-top: 20rpx; padding: 22rpx; background: #eaf0e6; border-radius: 16rpx; font-size: 27rpx; }
.exercise-section { margin-top: 40rpx; }
.exercise-row { display: flex; align-items: center; padding: 28rpx 24rpx; margin-top: 16rpx; min-height: 136rpx; background: #fff; border: 1rpx solid #e3e9e1; border-radius: 24rpx; }
.exercise-mark { width: 72rpx; height: 72rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #eaf0e6; border-radius: 20rpx; font-size: 27rpx; font-weight: 600; color: #456a50; }
.exercise-info { flex: 1; min-width: 0; margin-left: 22rpx; }
.exercise-name { font-size: 32rpx; font-weight: 600; }
.exercise-description { font-size: 23rpx; color: #66776c; margin-top: 8rpx; }
.exercise-trailing { display: flex; align-items: center; flex-shrink: 0; margin-left: 16rpx; }
.arrow { color: #89978d; margin-left: 14rpx; font-size: 36rpx; }
.availability { margin-top: 36rpx; font-size: 24rpx; }
