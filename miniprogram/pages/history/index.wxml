<view class="page">
  <view class="history-heading"><view class="page-title">训练记录</view><navigator class="record-link" url="/pages/statistics/index">数据统计 ›</navigator></view>
  <view class="muted">保存在本机 · 共 {{total}} 条符合筛选的记录</view>
  <view class="card spaced record-filters">
    <picker mode="selector" range="{{exerciseOptions}}" value="{{exerciseIndex}}" bindchange="onExerciseChange"><view class="filter-field">{{exerciseOptions[exerciseIndex]}} ▾</view></picker>
    <view class="filter-dates"><picker mode="date" value="{{startDate}}" data-key="startDate" bindchange="onDateChange"><view class="filter-field">{{startDate || '开始日期'}} ▾</view></picker><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="onDateChange"><view class="filter-field">{{endDate || '结束日期'}} ▾</view></picker></view>
    <button class="opt-button" bindtap="resetFilters">清除筛选</button>
  </view>
  <view wx:if="{{warning}}" class="opt-warning">{{warning}}</view>
  <view wx:if="{{message}}" class="opt-warning">{{message}}</view>
  <view wx:for="{{groups}}" wx:key="date" wx:for-item="day" class="record-day">
    <view class="section-title spaced">{{day.date}}</view>
    <navigator wx:for="{{day.records}}" wx:key="id" class="card record-card" url="{{item.url}}" hover-class="button-hover">
      <view class="record-row"><text class="section-title">{{item.name}}</text><text class="record-volume">{{item.actual}} {{item.unit}} ›</text></view>
      <view class="muted">{{item.purpose}} · {{item.startTime}} · {{item.status}}</view>
      <view class="record-row muted"><text>训练 {{item.elapsed}}</text><text>完成率 {{item.completion}}</text></view>
    </navigator>
  </view>
  <empty-state wx:if="{{!groups.length && !locked}}" heading="还没有符合条件的记录" description="完成训练并保存结果后会显示在这里，也可以清除日期或运动筛选。" show-home="{{false}}" />
  <button wx:if="{{hasMore}}" class="button button-secondary spaced" bindtap="loadMore">加载更多记录</button>
  <view class="record-data-actions"><button class="opt-button" bindtap="openExport" disabled="{{locked}}">导出本地备份</button><button class="opt-button" bindtap="openImport" disabled="{{locked}}">导入备份</button></view>
  <view class="muted spaced">训练数据只保存在本机。卸载或清理微信缓存可能丢失数据，建议定期导出文本备份。</view>
  <view wx:if="{{dataPanel}}" class="data-mask"><view class="data-sheet">
    <view class="section-title">{{dataPanel === 'export' ? '本地备份文本' : '导入本地备份'}}</view>
    <block wx:if="{{dataPanel === 'export'}}"><view class="muted spaced">长按文本框全选、复制，另存为文本文件。包含训练结果、能力与计划；不包含图片、原始信号或传感器参数。</view><textarea class="backup-input" value="{{backupText}}" maxlength="-1" /></block>
    <block wx:else>
      <view class="muted spaced">粘贴完整备份文本。先校验预览，确认后合并；同ID冲突保留本机，已删除记录不会被旧备份复活。导入不重复推进训练计划。</view>
      <textarea class="backup-input" value="{{importText}}" bindinput="onImportInput" maxlength="4194304" placeholder="粘贴 JSON 备份文本" />
      <button class="button button-secondary spaced" bindtap="previewImport">校验并预览</button>
      <view wx:if="{{importReport}}" class="muted spaced">新增 {{importReport.added}} 条 · 重复 {{importReport.duplicates}} 条 · 冲突 {{importReport.conflicts}} 条 · 已删除拦截 {{importReport.blockedByDeletion}} 条 · 新能力资料 {{importReport.profiles}} 项</view>
      <button wx:if="{{importReport}}" class="button button-primary spaced" bindtap="confirmImport">确认合并导入</button>
    </block>
    <view wx:if="{{message}}" class="opt-warning">{{message}}</view><button class="opt-button" bindtap="closeDataPanel">关闭</button>
  </view></view>
</view>
