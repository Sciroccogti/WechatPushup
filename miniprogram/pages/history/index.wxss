.history-heading, .record-row, .filter-dates, .record-data-actions { display: flex; align-items: center; justify-content: space-between; }
.record-link { padding: 20rpx 0 20rpx 20rpx; color: #c84716; font-size: 26rpx; }
.record-filters { padding: 20rpx; }
.filter-field { padding: 18rpx; background: #e9eef5; border-radius: 14rpx; font-size: 25rpx; min-height: 80rpx; }
.filter-dates { gap: 12rpx; margin-top: 12rpx; }
.filter-dates picker { flex: 1; min-width: 0; }
.record-card { display: block; margin-top: 16rpx; padding: 26rpx; }
.record-row { gap: 16rpx; flex-wrap: wrap; }
.record-volume { color: #c84716; font-size: 32rpx; font-weight: 700; }
.record-data-actions { gap: 16rpx; margin-top: 32rpx; }
.record-data-actions button { flex: 1; }
.data-mask { position: fixed; inset: 0; z-index: 50; background: rgba(17,30,47,.65); display: flex; align-items: flex-end; padding: 20rpx; }
.data-sheet { width: 100%; max-height: 90vh; overflow-y: auto; padding: 28rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx; background: #fff; }
.backup-input { width: 100%; height: 32vh; box-sizing: border-box; padding: 18rpx; margin-top: 20rpx; background: #e9eef5; font-size: 24rpx; border-radius: 16rpx; }
