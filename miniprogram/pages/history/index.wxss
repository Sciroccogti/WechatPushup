.history-heading, .record-row, .filter-dates, .record-data-actions { display: flex; align-items: center; justify-content: space-between; }
.record-link { padding: 20rpx 0 20rpx 20rpx; color: #245dbe; font-size: 26rpx; }
.record-filters { padding: 20rpx; }
.filter-field { display: flex; align-items: center; padding: 18rpx 20rpx; background: #edf2f9; border: 1rpx solid #e3eaf4; border-radius: 20rpx; font-size: 25rpx; min-height: 88rpx; }
.filter-dates { gap: 12rpx; margin-top: 12rpx; }
.filter-dates picker { flex: 1; min-width: 0; }
.record-card { display: block; margin-top: 16rpx; padding: 28rpx; }
.record-row { gap: 16rpx; flex-wrap: wrap; }
.record-volume { color: #245dbe; font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.record-card .muted { margin-top: 8rpx; font-size: 24rpx; }
.record-day > .section-title { color: #5d6f87; font-size: 25rpx; padding-left: 4rpx; }
.record-data-actions { gap: 16rpx; margin-top: 32rpx; }
.record-data-actions button { flex: 1; }
.data-mask { position: fixed; inset: 0; z-index: 50; background: rgba(20,43,73,.65); display: flex; align-items: flex-end; padding: 20rpx; }
.data-sheet { width: 100%; max-height: 90vh; overflow-y: auto; padding: 28rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx; background: #fff; }
.backup-input { width: 100%; height: 32vh; box-sizing: border-box; padding: 20rpx; margin-top: 20rpx; background: #edf2f9; border: 1rpx solid #e3eaf4; font-size: 24rpx; border-radius: 20rpx; }
