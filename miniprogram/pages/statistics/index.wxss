.stats-filters, .stats-grid { display: flex; gap: 16rpx; }
.stats-filters picker { flex: 1; min-width: 0; }
.stats-grid { flex-wrap: wrap; margin-top: 24rpx; }
.stat { width: calc(50% - 8rpx); padding: 24rpx; }
.stat-value { color: #245dbe; font-size: 54rpx; font-weight: 700; margin-top: 10rpx; word-break: break-all; }
.stat-value text { font-size: 24rpx; font-weight: 400; }
.stat-time { font-size: 32rpx; }
.chart { height: 300rpx; display: flex; align-items: stretch; gap: 12rpx; margin-top: 24rpx; overflow-x: auto; }
.chart-column { flex: 0 0 52rpx; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.bar-track { height: 200rpx; width: 100%; display: flex; align-items: flex-end; background: #f2f5fa; border-radius: 8rpx; overflow: hidden; }
.bar { width: 100%; background: #245dbe; border-radius: 8rpx 8rpx 0 0; }
.bar-value { font-size: 24rpx; color: #182e49; }
.bar-date { font-size: 22rpx; color: #5d6f87; white-space: nowrap; }
.ability-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #d5dfed; font-size: 28rpx; }
.ability-track { height: 10rpx; background: #e8eef7; margin: 8rpx 0; border-radius: 6rpx; }
.ability-bar { height: 100%; background: #245dbe; border-radius: 6rpx; }
