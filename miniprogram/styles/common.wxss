/* 共用视觉尺度：页面留白32，卡片圆角28，控件圆角20；训练大触区另有覆盖。 */
page { background: #f2f5fa; color: #182e49; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 28rpx; line-height: 1.6; }
view, navigator, button { box-sizing: border-box; }
.page { max-width: 900rpx; margin: 0 auto; padding: 32rpx 32rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.card { display: block; background: #fff; border: 1rpx solid #e3eaf4; border-radius: 28rpx; padding: 28rpx; box-shadow: 0 6rpx 24rpx rgba(20,43,73,.035); }
.muted { color: #5d6f87; font-size: 26rpx; }
.button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; padding: 20rpx 28rpx; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.button-primary { background: #245dbe; color: #fff; box-shadow: 0 8rpx 20rpx rgba(36,93,190,.14); }
.button-secondary { background: #e8f0fc; color: #245dbe; }
.button-hover { opacity: .8; }
.type-tag { display: inline-block; padding: 6rpx 16rpx; font-size: 22rpx; line-height: 1.5; color: #245dbe; background: #edf3fc; border-radius: 12rpx; white-space: nowrap; }
.type-timed { color: #245dbe; background: #e8f0fc; }
.page-title { font-size: 44rpx; line-height: 1.3; font-weight: 700; letter-spacing: -1rpx; margin-bottom: 12rpx; }
.section-title { font-size: 30rpx; line-height: 1.5; font-weight: 600; }
.page-eyebrow { color: #5d6f87; font-size: 24rpx; margin-bottom: 12rpx; }
.spaced { margin-top: 24rpx; }
.field-input { min-height: 96rpx; box-sizing: border-box; margin-top: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; background: #edf2f9; border: 1rpx solid #e3eaf4; border-radius: 20rpx; color: #182e49; }
.form-card { margin-top: 32rpx; }
.plan-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf2f9; font-size: 25rpx; }
.home-link { text-align: center; color: #3e5a7c; margin-top: 24rpx; }
button { font-size: 28rpx; border-radius: 20rpx; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
