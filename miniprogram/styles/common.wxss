page { background: #f1f4f8; color: #12243a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.6; }
view, navigator, button { box-sizing: border-box; }
.page { max-width: 900rpx; margin: 0 auto; padding: 40rpx 32rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border: 1rpx solid #dce3ed; border-radius: 28rpx; padding: 32rpx; }
.muted { color: #607087; font-size: 26rpx; }
.button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; padding: 20rpx 28rpx; font-size: 30rpx; font-weight: 600; }
.button-primary { background: #c84716; color: #fff; }
.button-secondary { background: #fff0e6; color: #c84716; }
.button-hover { opacity: .8; }
.type-tag { display: inline-block; padding: 5rpx 14rpx; font-size: 22rpx; line-height: 1.5; color: #425a79; background: #fff0e6; border-radius: 12rpx; white-space: nowrap; }
.type-timed { color: #a14617; background: #ffecd9; }
.page-title { font-size: 40rpx; line-height: 1.5; font-weight: 700; }
.section-title { font-size: 30rpx; font-weight: 600; }
.spaced { margin-top: 24rpx; }
.field-input { min-height: 96rpx; box-sizing: border-box; margin-top: 20rpx; padding: 20rpx; font-size: 29rpx; background: #e9eef5; border-radius: 16rpx; }
.form-card { margin-top: 32rpx; }
.plan-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #e7ecf3; font-size: 25rpx; }
.home-link { text-align: center; color: #425a79; margin-top: 24rpx; }
button { font-size: 28rpx; border-radius: 18rpx; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
