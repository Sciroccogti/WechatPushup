page { background: #f5f7f4; color: #18281f; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; line-height: 1.6; }
view, navigator, button { box-sizing: border-box; }
.page { max-width: 900rpx; margin: 0 auto; padding: 40rpx 32rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.card { background: #fff; border: 1rpx solid #e3e9e1; border-radius: 28rpx; padding: 32rpx; }
.muted { color: #66776c; font-size: 26rpx; }
.button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; padding: 20rpx 28rpx; font-size: 30rpx; font-weight: 600; }
.button-primary { background: #285d3e; color: #fff; }
.button-secondary { background: #eaf0e6; color: #285d3e; }
.button-hover { opacity: .8; }
