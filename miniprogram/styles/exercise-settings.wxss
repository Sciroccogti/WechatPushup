.settings-tabs { position: sticky; top: 0; z-index: 12; display: flex; margin-top: 24rpx; padding: 8rpx; background: #e8eef7; border: 1rpx solid #e3eaf4; border-radius: 20rpx; }
.settings-tab { flex: 1; min-width: 0; min-height: 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 10rpx 2rpx; border-radius: 14rpx; font-size: 25rpx; font-weight: 600; line-height: 1.4; color: #5d6f87; background: transparent; }
.settings-tab-selected { background: #fff0e5; color: #a83d13; box-shadow: 0 4rpx 12rpx rgba(20,43,73,.08); }
.opt-live-strip { top: 108rpx; }
