.opt-page-title { font-size: 40rpx; font-weight: 700; }
.opt-live-strip { position: sticky; top: 0; z-index: 10; padding: 20rpx 22rpx; margin-top: 20rpx; border: 1rpx solid #bfd0b5; border-radius: 18rpx; background: #f1f7eb; }
.opt-live-values { display: flex; justify-content: space-between; font-size: 25rpx; font-weight: 600; }
.opt-panel { padding: 28rpx; border: 1rpx solid #e3e9e1; border-radius: 24rpx; margin-top: 24rpx; background: #fff; }
.opt-title { font-size: 30rpx; font-weight: 600; }
.opt-hint { color: #66776c; font-size: 23rpx; line-height: 1.7; margin-top: 14rpx; overflow-wrap: break-word; }
.opt-camera { margin-top: 20rpx; width: 100%; height: 280rpx; }
.opt-placeholder { margin-top: 20rpx; padding: 32rpx; text-align: center; background: #f0f4ed; color: #66776c; font-size: 25rpx; border-radius: 16rpx; }
.opt-row { display: flex; margin-top: 16rpx; }
.opt-button { background: #eaf0e6; color: #285d3e; border-radius: 16rpx; padding: 8rpx 16rpx; margin: 16rpx 0 0; font-size: 25rpx; }
.opt-row .opt-button { flex: 1; min-width: 0; margin: 0 4rpx; }
.opt-button::after { border: 0; }
.opt-button[disabled] { opacity: .5; color: #66776c; background: #e5e9e1; }
.opt-primary { background: #285d3e; color: #fff; }
.opt-status { font-size: 25rpx; line-height: 1.7; margin-top: 22rpx; color: #285d3e; }
.opt-grid { display: flex; flex-wrap: wrap; }
.opt-grid > view { width: 50%; padding-top: 20rpx; }
.opt-label { display: block; font-size: 23rpx; color: #66776c; }
.opt-value { display: block; margin-top: 4rpx; font-size: 29rpx; font-weight: 600; }
.opt-meter { position: relative; height: 18rpx; background: #edf1e8; margin-top: 28rpx; border-radius: 8rpx; }
.opt-meter-fill { height: 100%; background: #97c885; border-radius: 8rpx; }
.opt-marker { position: absolute; top: -6rpx; width: 3rpx; height: 30rpx; }
.opt-dark-marker { background: #8b693c; }
.opt-light-marker { background: #285d3e; }
.opt-slider { margin-top: 26rpx; }
.opt-slider-label { display: flex; justify-content: space-between; font-size: 25rpx; }
.opt-warning { padding: 20rpx; margin-top: 20rpx; background: #fff0d8; color: #785629; border-radius: 16rpx; font-size: 25rpx; }
.opt-modal-mask { position: fixed; z-index: 1000; top: 0; bottom: 0; left: 0; right: 0; display: flex; align-items: center; background: rgba(0,0,0,.8); padding: 32rpx; }
.opt-modal { width: 100%; padding: 32rpx; background: #fff; border-radius: 24rpx; }
