.page { padding: 36rpx 28rpx 60rpx; padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 22rpx; color: #a1b8ca; letter-spacing: 3rpx; }
.title { font-size: 48rpx; font-weight: 700; margin: 16rpx 0; }
.notice { display: inline-block; color: #f6d391; background: #3c3426; border-radius: 12rpx; padding: 10rpx 16rpx; font-size: 23rpx; }
.description { color: #b2c4d2; font-size: 26rpx; line-height: 1.75; margin: 20rpx 0; }
.card { margin-top: 28rpx; padding: 28rpx; background: #1b2a38; border: 1rpx solid #2b4053; border-radius: 24rpx; }
.section-title { font-size: 27rpx; font-weight: 600; margin-bottom: 24rpx; color: #dbe9f3; }
.primary { background: #9be580; color: #13230f; font-weight: 600; padding: 8rpx 12rpx; }
.secondary { background: #2b4053; color: #e1edf6; padding: 4rpx 12rpx; }
.full { margin-top: 20rpx; }
.row { display: flex; margin-top: 18rpx; }
.row button { flex: 1; margin: 0 6rpx; min-width: 0; }
.hint { color: #a9bdcd; font-size: 23rpx; line-height: 1.65; margin-top: 16rpx; overflow-wrap: break-word; }
.picker { margin-top: 22rpx; padding: 20rpx 12rpx; border-bottom: 1rpx solid #3b5165; font-size: 25rpx; }
.camera { width: 100%; height: 340rpx; border-radius: 16rpx; }
.camera-placeholder { height: 130rpx; display: flex; align-items: center; justify-content: center; background: #14212c; color: #a9bdcd; border-radius: 16rpx; font-size: 24rpx; }
.status { font-size: 26rpx; line-height: 1.7; margin-top: 22rpx; color: #b8e9a9; }
.warning { color: #ffd18d; }
.progress { height: 8rpx; background: #34485b; border-radius: 8rpx; margin-top: 22rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #9be580; }
.signal-grid { display: flex; flex-wrap: wrap; }
.signal-grid > view { width: 50%; margin-top: 24rpx; }
.label { display: block; color: #a9bdcd; font-size: 24rpx; }
.signal { display: block; margin-top: 8rpx; font-size: 29rpx; font-weight: 600; }
.count-card { text-align: center; }
.count { font-size: 148rpx; font-weight: 700; line-height: 1.3; font-variant-numeric: tabular-nums; }
.touch-zone { padding: 52rpx 18rpx; background: #14212c; color: #a9bdcd; border-radius: 20rpx; font-size: 27rpx; margin-top: 16rpx; }
.touch-enabled { background: #294c31; color: #c1f1ad; border: 2rpx solid #79b861; }
.spaced { margin-top: 28rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; font-size: 26rpx; }
.modal-mask { position: fixed; z-index: 100; top: 0; bottom: 0; left: 0; right: 0; background: rgba(0,0,0,.8); display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.modal { padding: 32rpx; background: #1b2a38; border-radius: 24rpx; width: 100%; }
